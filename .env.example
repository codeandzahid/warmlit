# Copy to .env and fill in. Never commit .env. Never put keys in chat.
# Provider: echo (demo, no key) | openai (any OpenAI-compatible API) | ollama (free local model)
MODEL_PROVIDER=echo
# --- openai-compatible (OpenAI, OpenRouter, Meta Model API, ...) ---
# MODEL_API_KEY=
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# For Muse Wonder brain: get a Meta Model API key at dev.meta.ai,
# then set MODEL_BASE_URL + MODEL_NAME to Meta's endpoint/model.
# --- ollama (install from ollama.com, then: ollama pull llama3.2) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# --- plans ---
FREE_DAILY_LIMIT=50
# Owner only: secret used to sign Paid license keys. Never share.
# LICENSE_SECRET=change-me-to-a-long-random-string
